---
import "../styles/global.css";
const { title = "Hoshiworks" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-slate-950 text-slate-100">
    <header
      id="topbar"
      class="fixed top-0 left-0 right-0 z-40 border-b border-slate-800 bg-slate-950/75 backdrop-blur
             opacity-0 pointer-events-none transition-opacity duration-300"
    >
      <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
        <a href="#" class="text-sm font-semibold tracking-wide hover:text-slate-200 transition">
          Hoshiworks
        </a>

        <a href="/start" class="text-sm text-slate-300 hover:text-slate-100 transition">
          Start a project →
        </a>
      </div>
    </header>

    <main class="min-h-screen">
      <slot />
    </main>

    <script is:inline>
      const topbar = document.getElementById("topbar");
      const threshold = 80;

      const update = () => {
        const show = window.scrollY > threshold;
        if (show) {
          topbar.classList.remove("opacity-0", "pointer-events-none");
          topbar.classList.add("opacity-100");
        } else {
          topbar.classList.add("opacity-0", "pointer-events-none");
          topbar.classList.remove("opacity-100");
        }
      };

      update();
      window.addEventListener("scroll", update, { passive: true });
    </script>
  </body>
</html>
