---
import "../styles/global.css";
const { title = "Hoshiworks" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <main class="min-h-screen">
      <slot />
    </main>
  </body>
</html>
