---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Thanks | Hoshiworks">
  <main class="px-6 py-20">
    <div class="max-w-2xl mx-auto text-center space-y-6">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">Thanks, received.</h1>
      <p class="text-slate-300">
        I’ve received your intake. I typically review new submissions within 1 to 2 business days.
      </p>
      <p class="text-slate-400 text-sm">
        You should also receive a confirmation email and a PDF copy of what you submitted for your records.
      </p>
      <div class="pt-4">
        <a href="/" class="text-sm text-slate-300 hover:text-slate-100 transition">Back to home →</a>
      </div>
    </div>
  </main>
</Layout>
