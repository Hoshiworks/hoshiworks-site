---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Start a Project | Hoshiworks">
  <main class="px-6 py-16">
    <div class="max-w-3xl mx-auto space-y-10">
      <header class="space-y-5 text-center">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">
          Start a project
        </h1>

        <p class="text-slate-300 max-w-2xl mx-auto">
          This is a short intake to help me to understand your work and how
          Hoshiworks can help.
        </p>

        <div
          class="max-w-2xl mx-auto rounded-2xl border border-slate-800 bg-slate-900/30 px-5 py-4 text-left"
        >
          <ul class="space-y-1 text-sm text-slate-300">
            <li>
              <span class="text-slate-100 font-medium">Time estimate:</span> 5 to
              7 minutes
            </li>
            <li>
              <span class="text-slate-100 font-medium">Capacity:</span> I take on
              a small number of projects at a time to ensure quality.
            </li>
            <li class="text-slate-400">
              I typically review new intakes within 1 to 2 business days.
            </li>
          </ul>
        </div>
      </header>

      <section
        class="rounded-2xl border border-slate-800 bg-slate-900/30 p-6 sm:p-8"
      >
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <h2 class="text-2xl font-semibold text-white">
            Project intake is currently paused
          </h2>

          <p class="mt-4 text-slate-300">
            Hoshiworks is not currently taking on new automation projects while
            I prepare for law school.
          </p>

          <p class="mt-4 text-slate-300">
            For limited inquiries, you can still reach me at
            <a
              class="text-yellow-300 underline hover:text-yellow-200"
              href="mailto:phosh.hoshiworks@gmail.com"
            >
              phosh.hoshiworks@gmail.com
            </a>.
          </p>
        </div>
      </section>
    </div>
  </main>
</Layout>
